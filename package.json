{
  "name": "ohm-sweet-ohm",
  "version": "0.1.0",
  "private": true,
  "description": "OhmSweetOhm web app skeleton for managing a home electronics workshop.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "scripts/test-integration.sh",
    "typecheck": "pnpm prisma:generate && next typegen && tsc --noEmit",
    "test:db:up": "scripts/test-integration.sh up",
    "test:db:down": "scripts/test-integration.sh down",
    "db:seed:dev": "tsx prisma/seed.dev.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "worker": "tsx --tsconfig scripts/tsconfig.json scripts/workspace-deletion-worker.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "1.6.23",
    "next": "16.2.10",
    "pg": "8.22.0",
    "pg-boss": "12.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.12.0",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.6.6",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "18.0.9",
    "eslint": "10.14.0",
    "eslint-config-next": "16.2.10",
    "postcss": "8.5.19",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "v26.13.1",
    "pnpm": "11.9.0"
  },
  "packageManager": "pnpm@11.9.0"
}
