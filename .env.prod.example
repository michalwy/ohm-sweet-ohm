# Production / self-hosting configuration for OhmSweetOhm.
#
# Copy this file to `.env` next to docker-compose.prod.yml and fill in the values.
# The install script (scripts/install.sh) generates this file for you interactively.
# `.env` holds secrets and must NOT be committed to version control.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Connection string for your externally managed PostgreSQL database.
# OhmSweetOhm does NOT run or back up this database — you own it. The database
# must already exist and be reachable from the app container. If Postgres runs
# on the same host outside Docker, use host.docker.internal (or the host IP).
DATABASE_URL="postgresql://oso:CHANGE_ME@your-db-host:5432/ohm_sweet_ohm?schema=public"

# Public URL where this deployment is reachable (used for auth callbacks/links).
BETTER_AUTH_URL="http://your-server:3000"

# Authentication secret. Must be at least 32 random characters.
# Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# ---------------------------------------------------------------------------
# Optional (sensible defaults shown)
# ---------------------------------------------------------------------------

# Days an archived workspace is retained before automatic permanent deletion.
WORKSPACE_RETENTION_DAYS=30

# Image tag to run. Keep "latest" for rolling updates, or pin a specific
# sha-<short> / version tag (e.g. sha-a1b2c3d, 1.4.0) to roll back or freeze.
OSO_IMAGE_TAG=latest

# Host port to expose the app on.
OSO_HTTP_PORT=3000

# Auto-update. Leave empty to disable, or set to "autoupdate" to run the
# Watchtower watcher that pulls and restarts on new images.
COMPOSE_PROFILES=

# Watchtower poll interval in seconds (only used when COMPOSE_PROFILES=autoupdate).
OSO_UPDATE_INTERVAL=3600
