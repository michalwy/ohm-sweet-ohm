# Local PostgreSQL database name used by Docker Compose.
POSTGRES_DB="ohm_sweet_ohm"

# Local PostgreSQL user used by Docker Compose.
POSTGRES_USER="oso"

# Local PostgreSQL password used by Docker Compose.
POSTGRES_PASSWORD="oso_dev_password"

# Database URL used by the app outside Docker (for example native commands on host).
DATABASE_URL="postgresql://oso:oso_dev_password@localhost:5432/ohm_sweet_ohm?schema=public"

# Public app URL used by authentication callbacks and links.
BETTER_AUTH_URL="http://localhost:3000"

# Local auth secret for development only (replace for non-local deployments).
BETTER_AUTH_SECRET="ohm-sweet-ohm-local-development-auth-secret"

# Development seed password (used only by db:seed:dev workflows).
OSO_DEV_USER_PASSWORD="ohm-sweet-ohm-owner"
