generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Part {
  id               String   @id @default(cuid())
  catalogNumber    String
  manufacturerName String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([catalogNumber])
  @@index([manufacturerName])
}
