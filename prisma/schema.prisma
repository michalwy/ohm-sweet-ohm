generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Part {
  id                  String   @id @default(cuid())
  workspaceId         String
  unitId              String
  defaultLocationId   String?
  currentStock        Decimal  @default(0)
  plannedQty          Decimal  @default(0)
  onOrderQty          Decimal  @default(0)
  reservedQty         Decimal  @default(0)
  allocatedQty        Decimal  @default(0)
  avgNetCostPrimary   Decimal?
  avgGrossCostPrimary Decimal?
  catalogNumber       String
  description         String?
  manufacturerId      String
  primaryCategoryId   String?
  secondaryCategoryId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  unit              Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  defaultLocation   StorageLocation?     @relation("PartDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: SetNull)
  manufacturer      Organization         @relation("PartManufacturer", fields: [manufacturerId], references: [id], onDelete: Restrict)
  primaryCategory   PartCategory?        @relation("PartPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  secondaryCategory PartCategory?        @relation("PartSecondaryCategory", fields: [secondaryCategoryId], references: [id], onDelete: SetNull)
  attributeValues    PartAttributeValue[]
  inventoryEntries   InventoryEntry[]
  shoppingListItems  ShoppingListItem[]
  purchaseOrderItems PurchaseOrderItem[]
  assembledByDesign  Design?             @relation("DesignOutputPart")
  pinnedByBomLineItems BomLineItem[]     @relation("BomLineItemPinnedPart")
  buildLineAllocations       BuildLineAllocation[]
  buildDesignatorAssignments BuildDesignatorAssignment[]

  @@unique([workspaceId, manufacturerId, catalogNumber])
  @@index([workspaceId, catalogNumber])
  @@index([workspaceId, unitId])
  @@index([workspaceId, defaultLocationId])
  @@index([workspaceId, currentStock, id])
  @@index([workspaceId, plannedQty, id])
  @@index([workspaceId, onOrderQty, id])
  @@index([workspaceId, reservedQty, id])
  @@index([workspaceId, allocatedQty, id])
  @@index([workspaceId, avgNetCostPrimary, id])
  @@index([workspaceId, avgGrossCostPrimary, id])
  @@index([workspaceId, manufacturerId])
  @@index([workspaceId, primaryCategoryId])
  @@index([workspaceId, secondaryCategoryId])
}

model Design {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  outputPartId String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outputPart Part           @relation("DesignOutputPart", fields: [outputPartId], references: [id], onDelete: Restrict)
  revisions  DesignRevision[]

  @@index([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model DesignRevision {
  id             String   @id @default(cuid())
  designId       String
  workspaceId    String
  revisionNumber Int
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  design    Design    @relation(fields: [designId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lineItems BomLineItem[]
  builds    Build[]

  @@unique([designId, revisionNumber])
  @@index([designId])
  @@index([workspaceId])
}

enum BomMatcherOperator {
  EQ
  NEQ
  LT
  LTE
  GT
  GTE
}

model BomLineItem {
  id           String   @id @default(cuid())
  workspaceId  String
  revisionId   String
  categoryId   String?
  pinnedPartId String?
  designators  String
  quantity     Int
  sortOrder    Int      @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  revision   DesignRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  category   PartCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  pinnedPart Part?          @relation("BomLineItemPinnedPart", fields: [pinnedPartId], references: [id], onDelete: SetNull)
  matchers   BomMatcher[]
  buildLineItems BuildLineItem[]

  @@index([workspaceId])
  @@index([revisionId, sortOrder])
}

model BomMatcher {
  id                String             @id @default(cuid())
  workspaceId       String
  lineItemId        String
  attributeId       String
  operator          BomMatcherOperator
  textValue         String?
  numberValue       Decimal?
  quantityBaseValue Decimal?
  booleanValue      Boolean?
  choiceOptionId    String?
  displayValue      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lineItem     BomLineItem            @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  attribute    Attribute              @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  choiceOption AttributeChoiceOption? @relation("BomMatcherChoiceOption", fields: [choiceOptionId], references: [id], onDelete: Restrict)

  @@unique([lineItemId, attributeId])
  @@index([workspaceId, lineItemId])
  @@index([attributeId])
}

enum BuildState {
  CREATED
  ALLOCATED
  STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Build {
  id               String     @id @default(cuid())
  workspaceId      String
  designRevisionId String
  outputLocationId String?
  targetQuantity   Int
  state            BuildState @default(CREATED)
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdByUserId  String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  designRevision DesignRevision   @relation(fields: [designRevisionId], references: [id], onDelete: Restrict)
  outputLocation StorageLocation? @relation("BuildOutputLocation", fields: [outputLocationId], references: [id], onDelete: Restrict)
  createdByUser  User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lineItems      BuildLineItem[]

  @@index([workspaceId, state, createdAt])
  @@index([workspaceId, createdAt])
  @@index([designRevisionId])
}

model BuildLineItem {
  id                  String  @id @default(cuid())
  workspaceId         String
  buildId             String
  sourceBomLineItemId String?
  designators         String
  designatorCount     Int
  categoryName        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  build            Build            @relation(fields: [buildId], references: [id], onDelete: Cascade)
  sourceBomLineItem BomLineItem?    @relation(fields: [sourceBomLineItemId], references: [id], onDelete: SetNull)
  allocations      BuildLineAllocation[]
  assignments      BuildDesignatorAssignment[]

  @@index([workspaceId])
  @@index([buildId])
}

/// One part entry in a build line's split allocation: a chosen part + source location and the
/// number of units of that part for the line. A line may have several entries whose quantities
/// sum to (designatorCount × build.targetQuantity). Edited while the build is CREATED.
model BuildLineAllocation {
  id               String   @id @default(cuid())
  workspaceId      String
  buildLineItemId  String
  partId           String
  sourceLocationId String?
  quantity         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  buildLineItem  BuildLineItem    @relation(fields: [buildLineItemId], references: [id], onDelete: Cascade)
  part           Part             @relation(fields: [partId], references: [id], onDelete: Restrict)
  sourceLocation StorageLocation? @relation("BuildAllocationSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([buildLineItemId])
  @@index([partId])
}

/// One distributed unit-group of a single part at a single designator (the assembly-list grain).
/// Because the split is per-unit, a designator may have several rows (one per part it draws from)
/// whose quantities sum to build.targetQuantity. Generated by distribution at STARTED.
model BuildDesignatorAssignment {
  id                String   @id @default(cuid())
  workspaceId       String
  buildLineItemId   String
  designator        String
  partId            String?
  sourceLocationId  String?
  quantity          Int
  assembledQuantity Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  buildLineItem  BuildLineItem    @relation(fields: [buildLineItemId], references: [id], onDelete: Cascade)
  part           Part?            @relation(fields: [partId], references: [id], onDelete: Restrict)
  sourceLocation StorageLocation? @relation("BuildDesignatorSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([buildLineItemId])
  @@index([partId])
}

model Unit {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  normalizedName String
  symbol         String
  allowsFraction Boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parts     Part[]

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, symbol])
}

model StorageLocation {
  id             String   @id @default(cuid())
  workspaceId    String
  parentId       String?
  name           String
  normalizedName String
  isAssignable   Boolean  @default(true)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent                StorageLocation?  @relation("StorageLocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children              StorageLocation[] @relation("StorageLocationTree")
  defaultForParts       Part[]            @relation("PartDefaultLocation")
  inventoryEntriesFrom  InventoryEntry[]  @relation("InventoryEntryFromLocation")
  inventoryEntriesTo    InventoryEntry[]  @relation("InventoryEntryToLocation")
  buildAllocationSources BuildLineAllocation[]       @relation("BuildAllocationSourceLocation")
  buildDesignatorSources BuildDesignatorAssignment[] @relation("BuildDesignatorSourceLocation")
  buildOutputs           Build[]                     @relation("BuildOutputLocation")

  @@unique([workspaceId, parentId, normalizedName])
  @@index([workspaceId, parentId])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, isAssignable])
  @@index([workspaceId, name])
}

enum InventoryEntryType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
}

model InventoryEntry {
  id                  String             @id @default(cuid())
  workspaceId         String
  partId              String
  entryType           InventoryEntryType
  quantity            Decimal
  fromLocationId      String?
  toLocationId        String?
  note                String?
  unitCost             Decimal?
  costCurrency         String?
  unitCostPrimary      Decimal?
  unitGrossCostPrimary Decimal?
  createdByUserId      String?
  createdAt           DateTime           @default(now())

  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  part                Part               @relation(fields: [partId], references: [id], onDelete: Cascade)
  fromLocation        StorageLocation?   @relation("InventoryEntryFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation          StorageLocation?   @relation("InventoryEntryToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  createdByUser       User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, partId, createdAt])
  @@index([workspaceId, fromLocationId])
  @@index([workspaceId, toLocationId])
  @@index([workspaceId, entryType, createdAt])
}

enum AttributeType {
  TEXT
  NUMBER
  QUANTITY
  BOOLEAN
  CHOICE
}

model Attribute {
  id             String        @id @default(cuid())
  workspaceId    String
  name           String
  normalizedName String
  description    String?
  type           AttributeType
  baseUnitSymbol String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  choiceOptions        AttributeChoiceOption[]
  categoryAttributes   CategoryAttribute[]
  workspaceAttributes  WorkspaceAttribute[]
  partValues           PartAttributeValue[]
  valueForCategories   PartCategory[]          @relation("PartCategoryValueAttribute")
  supplierAttributeMappingStats SupplierAttributeMappingStat[]
  bomMatchers          BomMatcher[]

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, name])
  @@index([workspaceId, type])
}

model AttributeChoiceOption {
  id              String   @id @default(cuid())
  attributeId     String
  label           String
  normalizedLabel String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attribute                      Attribute            @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  categoryAttributeDefaultValues CategoryAttribute[]  @relation("CategoryAttributeDefaultChoiceOption")
  workspaceAttributeDefaultValues WorkspaceAttribute[] @relation("WorkspaceAttributeDefaultChoiceOption")
  partAttributeValues            PartAttributeValue[] @relation("PartAttributeValueChoiceOption")
  bomMatchers                    BomMatcher[]         @relation("BomMatcherChoiceOption")

  @@unique([attributeId, normalizedLabel])
  @@index([attributeId, sortOrder])
  @@index([attributeId, label])
}

model Organization {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  normalizedName String
  isInternal            Boolean  @default(false)
  currency              String?
  defaultPriceEntryMode String?
  defaultTaxRate        Decimal?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roles             OrganizationRole[]
  manufacturedParts Part[]             @relation("PartManufacturer")
  purchaseOrders    PurchaseOrder[]    @relation("PurchaseOrderSupplier")
  supplierManufacturerMappingStats SupplierManufacturerMappingStat[]

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, name])
}

model OrganizationRole {
  organizationId String
  role           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, role])
  @@index([role])
}

model PartCategory {
  id                 String   @id @default(cuid())
  workspaceId        String
  parentId           String?
  valueAttributeId   String?
  name               String
  isAssignable       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent             PartCategory?         @relation("PartCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           PartCategory[]        @relation("PartCategoryTree")
  valueAttribute     Attribute?            @relation("PartCategoryValueAttribute", fields: [valueAttributeId], references: [id], onDelete: Restrict)
  categoryAttributes CategoryAttribute[]
  primaryParts       Part[]                @relation("PartPrimaryCategory")
  secondaryParts     Part[]                @relation("PartSecondaryCategory")
  ancestorClosures   PartCategoryClosure[] @relation("PartCategoryClosureAncestor")
  descendantClosures PartCategoryClosure[] @relation("PartCategoryClosureDescendant")
  bomLineItems       BomLineItem[]

  @@index([workspaceId])
  @@index([workspaceId, parentId])
  @@index([workspaceId, valueAttributeId])
  @@index([workspaceId, name])
}

model CategoryAttribute {
  id                       String   @id @default(cuid())
  workspaceId              String
  categoryId               String
  attributeId              String
  sortOrder                Int      @default(0)
  defaultTextValue         String?
  defaultNumberValue       Decimal?
  defaultQuantityBaseValue Decimal?
  defaultBooleanValue      Boolean?
  defaultChoiceOptionId    String?
  defaultDisplayValue      String?
  isPrimary                Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category            PartCategory           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute           Attribute              @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  defaultChoiceOption AttributeChoiceOption? @relation("CategoryAttributeDefaultChoiceOption", fields: [defaultChoiceOptionId], references: [id], onDelete: Restrict)

  @@unique([categoryId, attributeId])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, attributeId])
  @@index([attributeId])
}

model WorkspaceAttribute {
  id                       String   @id @default(cuid())
  workspaceId              String
  attributeId              String
  sortOrder                Int      @default(0)
  defaultTextValue         String?
  defaultNumberValue       Decimal?
  defaultQuantityBaseValue Decimal?
  defaultBooleanValue      Boolean?
  defaultChoiceOptionId    String?
  defaultDisplayValue      String?
  isPrimary                Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attribute           Attribute              @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  defaultChoiceOption AttributeChoiceOption? @relation("WorkspaceAttributeDefaultChoiceOption", fields: [defaultChoiceOptionId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, attributeId])
  @@index([workspaceId, attributeId])
  @@index([attributeId])
}

model PartAttributeValue {
  id                String   @id @default(cuid())
  workspaceId       String
  partId            String
  attributeId       String
  textValue         String?
  numberValue       Decimal?
  quantityBaseValue Decimal?
  booleanValue      Boolean?
  choiceOptionId    String?
  displayValue      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  part         Part                   @relation(fields: [partId], references: [id], onDelete: Cascade)
  attribute    Attribute              @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  choiceOption AttributeChoiceOption? @relation("PartAttributeValueChoiceOption", fields: [choiceOptionId], references: [id], onDelete: Restrict)

  @@unique([partId, attributeId])
  @@index([workspaceId, partId])
  @@index([workspaceId, attributeId])
  @@index([attributeId])
  @@index([choiceOptionId])
}

model PartCategoryClosure {
  workspaceId  String
  ancestorId   String
  descendantId String
  depth        Int

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ancestor   PartCategory @relation("PartCategoryClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant PartCategory @relation("PartCategoryClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([workspaceId, ancestorId])
  @@index([workspaceId, descendantId])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships             WorkspaceMember[]
  sessions                Session[]
  accounts                Account[]
  inventoryEntriesCreated InventoryEntry[]
  shoppingListsCreated    ShoppingList[]
  purchaseOrdersCreated   PurchaseOrder[]
  buildsCreated           Build[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Workspace {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  primaryCurrency       String   @default("EUR")
  defaultPriceEntryMode String   @default("net")
  defaultTaxRate        Decimal?
  activeSupplierProvider SupplierProvider?
  archivedAt          DateTime?
  deletionScheduledAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members              WorkspaceMember[]
  parts                Part[]
  organizations        Organization[]
  partCategories       PartCategory[]
  partCategoryClosures PartCategoryClosure[]
  attributes           Attribute[]
  units                Unit[]
  storageLocations     StorageLocation[]
  inventoryEntries     InventoryEntry[]
  categoryAttributes   CategoryAttribute[]
  workspaceAttributes  WorkspaceAttribute[]
  partAttributeValues  PartAttributeValue[]
  roles                Role[]
  digiKeyIntegration   WorkspaceDigiKeyIntegration?
  tmeIntegration       WorkspaceTmeIntegration?
  tmeCategoryCaches    WorkspaceTmeCategoryCache[]
  supplierCategoryMappingStats SupplierCategoryMappingStat[]
  supplierAttributeMappingStats SupplierAttributeMappingStat[]
  supplierManufacturerMappingStats SupplierManufacturerMappingStat[]
  shoppingLists    ShoppingList[]
  purchaseOrders   PurchaseOrder[]
  designs          Design[]
  designRevisions  DesignRevision[]
  bomLineItems     BomLineItem[]
  bomMatchers      BomMatcher[]
  builds                     Build[]
  buildLineItems             BuildLineItem[]
  buildLineAllocations       BuildLineAllocation[]
  buildDesignatorAssignments BuildDesignatorAssignment[]

  @@index([archivedAt])
}

model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  date          DateTime @db.Date
  rate          Decimal
  fetchedAt     DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, date])
  @@index([baseCurrency, quoteCurrency, date])
}

enum SupplierProvider {
  DIGIKEY
  MOUSER
  TME
}

model SupplierCategoryMappingStat {
  id                String   @id @default(cuid())
  workspaceId       String
  provider          String
  sourceCategoryKey String
  targetCategoryId  String
  score             Int      @default(0)
  lastUsedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, sourceCategoryKey, targetCategoryId])
  @@index([workspaceId, provider, sourceCategoryKey, score, lastUsedAt])
}

model SupplierAttributeMappingStat {
  id                     String   @id @default(cuid())
  workspaceId            String
  provider               String
  sourceCategoryKey      String
  targetCategoryScopeKey String
  sourceAttributeKey     String
  targetAttributeId      String
  score                  Int      @default(0)
  lastUsedAt             DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [targetAttributeId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, sourceCategoryKey, targetCategoryScopeKey, sourceAttributeKey, targetAttributeId])
  @@index([workspaceId, provider, sourceCategoryKey, targetCategoryScopeKey, sourceAttributeKey, score, lastUsedAt])
  @@index([workspaceId, targetAttributeId])
}

model SupplierManufacturerMappingStat {
  id                    String   @id @default(cuid())
  workspaceId           String
  provider              String
  sourceManufacturerKey String
  targetManufacturerId  String
  score                 Int      @default(0)
  lastUsedAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targetManufacturer Organization @relation(fields: [targetManufacturerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, sourceManufacturerKey, targetManufacturerId])
  @@index([workspaceId, provider, sourceManufacturerKey, score, lastUsedAt])
  @@index([workspaceId, targetManufacturerId])
}

model WorkspaceDigiKeyIntegration {
  workspaceId   String   @id
  clientId      String
  clientSecret  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceTmeIntegration {
  workspaceId   String   @id
  clientId      String
  clientSecret  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceTmeCategoryCache {
  id              String   @id @default(cuid())
  workspaceId     String
  country         String
  categoriesJson  Json
  fetchedAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, country])
  @@index([workspaceId, country, fetchedAt])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roles     WorkspaceMemberRole[]

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     WorkspaceMemberRole[]
  permissions RolePermission[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Permission {
  key         String   @id
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId        String
  permissionKey String
  createdAt     DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

model WorkspaceMemberRole {
  workspaceMemberId String
  roleId            String
  createdAt         DateTime @default(now())

  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  role            Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([workspaceMemberId, roleId])
  @@index([roleId])
}

model ShoppingList {
  id              String             @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser  User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items          ShoppingListItem[]
  purchaseOrders PurchaseOrder[]

  @@index([workspaceId])
  @@index([workspaceId, name])
}

model ShoppingListItem {
  id             String   @id @default(cuid())
  shoppingListId String
  partId         String
  quantity       Decimal
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shoppingList       ShoppingList        @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  part               Part                @relation(fields: [partId], references: [id], onDelete: Restrict)
  purchaseOrderItems PurchaseOrderItem[]

  @@index([shoppingListId])
  @@index([partId])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  workspaceId          String
  supplierId           String
  sourceShoppingListId String?
  createdByUserId      String?
  status               PurchaseOrderStatus @default(DRAFT)
  orderNumber          String?
  supplierOrderNumber  String?
  currency             String?
  taxRate              Decimal?
  priceEntryMode       String    @default("net")
  orderedAt            DateTime?
  totalNetValue        Decimal?
  totalGrossValue      Decimal?
  totalNetValuePrimary    Decimal?
  totalGrossValuePrimary  Decimal?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier           Organization        @relation("PurchaseOrderSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  sourceShoppingList ShoppingList?       @relation(fields: [sourceShoppingListId], references: [id], onDelete: SetNull)
  createdByUser      User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items              PurchaseOrderItem[]

  @@index([workspaceId])
  @@index([workspaceId, supplierId])
  @@index([workspaceId, status])
  @@index([workspaceId, sourceShoppingListId])
  @@index([workspaceId, totalNetValue])
  @@index([workspaceId, totalGrossValue])
  @@index([workspaceId, totalNetValuePrimary])
  @@index([workspaceId, totalGrossValuePrimary])
}

model PurchaseOrderItem {
  id                       String   @id @default(cuid())
  purchaseOrderId          String
  partId                   String
  sourceShoppingListItemId String?
  quantity                 Decimal
  receivedQuantity         Decimal  @default(0)
  supplierSku              String?
  unitPrice                Decimal?
  lineNetValue             Decimal?
  lineGrossValue           Decimal?
  lineNetValuePrimary      Decimal?
  lineGrossValuePrimary    Decimal?
  currency                 String?
  taxRate                  Decimal?
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  purchaseOrder          PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part                   Part              @relation(fields: [partId], references: [id], onDelete: Restrict)
  sourceShoppingListItem ShoppingListItem? @relation(fields: [sourceShoppingListItemId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([partId])
  @@index([sourceShoppingListItemId])
}
