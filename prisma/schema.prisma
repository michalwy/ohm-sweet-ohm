generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Part {
  id               String   @id @default(cuid())
  catalogNumber    String
  manufacturerName String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([catalogNumber])
  @@index([manufacturerName])
}
