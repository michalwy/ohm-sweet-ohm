generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Part {
  id                  String   @id @default(cuid())
  workspaceId         String
  catalogNumber       String
  description         String?
  manufacturerId      String
  primaryCategoryId   String?
  secondaryCategoryId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  manufacturer      Organization         @relation("PartManufacturer", fields: [manufacturerId], references: [id], onDelete: Restrict)
  primaryCategory   PartCategory?        @relation("PartPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  secondaryCategory PartCategory?        @relation("PartSecondaryCategory", fields: [secondaryCategoryId], references: [id], onDelete: SetNull)
  attributeValues   PartAttributeValue[]

  @@unique([workspaceId, manufacturerId, catalogNumber])
  @@index([workspaceId, catalogNumber])
  @@index([workspaceId, manufacturerId])
  @@index([workspaceId, primaryCategoryId])
  @@index([workspaceId, secondaryCategoryId])
}

enum AttributeType {
  TEXT
  NUMBER
  QUANTITY
  BOOLEAN
  CHOICE
}

model Attribute {
  id             String        @id @default(cuid())
  workspaceId    String
  name           String
  normalizedName String
  description    String?
  type           AttributeType
  baseUnitSymbol String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  choiceOptions        AttributeChoiceOption[]
  categoryAttributes   CategoryAttribute[]
  workspaceAttributes  WorkspaceAttribute[]
  partValues           PartAttributeValue[]
  valueForCategories   PartCategory[]          @relation("PartCategoryValueAttribute")
  supplierAttributeMappingStats SupplierAttributeMappingStat[]

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, name])
  @@index([workspaceId, type])
}

model AttributeChoiceOption {
  id              String   @id @default(cuid())
  attributeId     String
  label           String
  normalizedLabel String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attribute                      Attribute            @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  categoryAttributeDefaultValues CategoryAttribute[]  @relation("CategoryAttributeDefaultChoiceOption")
  workspaceAttributeDefaultValues WorkspaceAttribute[] @relation("WorkspaceAttributeDefaultChoiceOption")
  partAttributeValues            PartAttributeValue[] @relation("PartAttributeValueChoiceOption")

  @@unique([attributeId, normalizedLabel])
  @@index([attributeId, sortOrder])
  @@index([attributeId, label])
}

model Organization {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roles             OrganizationRole[]
  manufacturedParts Part[]             @relation("PartManufacturer")
  supplierManufacturerMappingStats SupplierManufacturerMappingStat[]

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, name])
}

model OrganizationRole {
  organizationId String
  role           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, role])
  @@index([role])
}

model PartCategory {
  id                 String   @id @default(cuid())
  workspaceId        String
  parentId           String?
  valueAttributeId   String?
  name               String
  isAssignable       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent             PartCategory?         @relation("PartCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           PartCategory[]        @relation("PartCategoryTree")
  valueAttribute     Attribute?            @relation("PartCategoryValueAttribute", fields: [valueAttributeId], references: [id], onDelete: Restrict)
  categoryAttributes CategoryAttribute[]
  primaryParts       Part[]                @relation("PartPrimaryCategory")
  secondaryParts     Part[]                @relation("PartSecondaryCategory")
  ancestorClosures   PartCategoryClosure[] @relation("PartCategoryClosureAncestor")
  descendantClosures PartCategoryClosure[] @relation("PartCategoryClosureDescendant")

  @@index([workspaceId])
  @@index([workspaceId, parentId])
  @@index([workspaceId, valueAttributeId])
  @@index([workspaceId, name])
}

model CategoryAttribute {
  id                       String   @id @default(cuid())
  workspaceId              String
  categoryId               String
  attributeId              String
  sortOrder                Int      @default(0)
  defaultTextValue         String?
  defaultNumberValue       Decimal?
  defaultQuantityBaseValue Decimal?
  defaultBooleanValue      Boolean?
  defaultChoiceOptionId    String?
  defaultDisplayValue      String?
  isPrimary                Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category            PartCategory           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute           Attribute              @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  defaultChoiceOption AttributeChoiceOption? @relation("CategoryAttributeDefaultChoiceOption", fields: [defaultChoiceOptionId], references: [id], onDelete: Restrict)

  @@unique([categoryId, attributeId])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, attributeId])
  @@index([attributeId])
}

model WorkspaceAttribute {
  id                       String   @id @default(cuid())
  workspaceId              String
  attributeId              String
  sortOrder                Int      @default(0)
  defaultTextValue         String?
  defaultNumberValue       Decimal?
  defaultQuantityBaseValue Decimal?
  defaultBooleanValue      Boolean?
  defaultChoiceOptionId    String?
  defaultDisplayValue      String?
  isPrimary                Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attribute           Attribute              @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  defaultChoiceOption AttributeChoiceOption? @relation("WorkspaceAttributeDefaultChoiceOption", fields: [defaultChoiceOptionId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, attributeId])
  @@index([workspaceId, attributeId])
  @@index([attributeId])
}

model PartAttributeValue {
  id                String   @id @default(cuid())
  workspaceId       String
  partId            String
  attributeId       String
  textValue         String?
  numberValue       Decimal?
  quantityBaseValue Decimal?
  booleanValue      Boolean?
  choiceOptionId    String?
  displayValue      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  part         Part                   @relation(fields: [partId], references: [id], onDelete: Cascade)
  attribute    Attribute              @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  choiceOption AttributeChoiceOption? @relation("PartAttributeValueChoiceOption", fields: [choiceOptionId], references: [id], onDelete: Restrict)

  @@unique([partId, attributeId])
  @@index([workspaceId, partId])
  @@index([workspaceId, attributeId])
  @@index([attributeId])
  @@index([choiceOptionId])
}

model PartCategoryClosure {
  workspaceId  String
  ancestorId   String
  descendantId String
  depth        Int

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ancestor   PartCategory @relation("PartCategoryClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant PartCategory @relation("PartCategoryClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([workspaceId, ancestorId])
  @@index([workspaceId, descendantId])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships WorkspaceMember[]
  sessions    Session[]
  accounts    Account[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members              WorkspaceMember[]
  parts                Part[]
  organizations        Organization[]
  partCategories       PartCategory[]
  partCategoryClosures PartCategoryClosure[]
  attributes           Attribute[]
  categoryAttributes   CategoryAttribute[]
  workspaceAttributes  WorkspaceAttribute[]
  partAttributeValues  PartAttributeValue[]
  roles                Role[]
  digiKeyIntegration   WorkspaceDigiKeyIntegration?
  supplierCategoryMappingStats SupplierCategoryMappingStat[]
  supplierAttributeMappingStats SupplierAttributeMappingStat[]
  supplierManufacturerMappingStats SupplierManufacturerMappingStat[]
}

model SupplierCategoryMappingStat {
  id                String   @id @default(cuid())
  workspaceId       String
  provider          String
  sourceCategoryKey String
  targetCategoryId  String
  score             Int      @default(0)
  lastUsedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, sourceCategoryKey, targetCategoryId])
  @@index([workspaceId, provider, sourceCategoryKey, score, lastUsedAt])
}

model SupplierAttributeMappingStat {
  id                     String   @id @default(cuid())
  workspaceId            String
  provider               String
  sourceCategoryKey      String
  targetCategoryScopeKey String
  sourceAttributeKey     String
  targetAttributeId      String
  score                  Int      @default(0)
  lastUsedAt             DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [targetAttributeId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, sourceCategoryKey, targetCategoryScopeKey, sourceAttributeKey, targetAttributeId])
  @@index([workspaceId, provider, sourceCategoryKey, targetCategoryScopeKey, sourceAttributeKey, score, lastUsedAt])
  @@index([workspaceId, targetAttributeId])
}

model SupplierManufacturerMappingStat {
  id                    String   @id @default(cuid())
  workspaceId           String
  provider              String
  sourceManufacturerKey String
  targetManufacturerId  String
  score                 Int      @default(0)
  lastUsedAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targetManufacturer Organization @relation(fields: [targetManufacturerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, sourceManufacturerKey, targetManufacturerId])
  @@index([workspaceId, provider, sourceManufacturerKey, score, lastUsedAt])
  @@index([workspaceId, targetManufacturerId])
}

model WorkspaceDigiKeyIntegration {
  workspaceId   String   @id
  clientId      String
  clientSecret  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roles     WorkspaceMemberRole[]

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     WorkspaceMemberRole[]
  permissions RolePermission[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Permission {
  key         String   @id
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId        String
  permissionKey String
  createdAt     DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

model WorkspaceMemberRole {
  workspaceMemberId String
  roleId            String
  createdAt         DateTime @default(now())

  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  role            Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([workspaceMemberId, roleId])
  @@index([roleId])
}
